POSTGRES_DB=cofair_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5434
POSTGRES_HOST=localhost


# Neon / Netlify (for --neon and neon_testing notebook)
NETLIFY_DATABASE_URL_UNPOOLED=postgresql://...
# Or use NEON_DATABASE_URL for the notebook
NEON_HOST=...
NEON_USER=...
NEON_PASSWORD=...
NEON_DB=...

SLACK_BOT_TOKEN=...
SLACK_CHANNEL=#notifications

# Token-equivalence live task runs (weekly A/B/C/D).
# Prefer TRACKER_* in ../cofair/.env/.env.cofair so keys do not collide with
# exchange / M0 tracer credentials that already use the unprefixed names.
# Unprefixed names still work for CI and a local .env.
TRACKER_ANTHROPIC_API_KEY=...
TRACKER_OPENAI_API_KEY=...
TRACKER_GEMINI_API_KEY=...
TRACKER_XAI_API_KEY=...
TRACKER_DEEPSEEK_API_KEY=...
TRACKER_QWEN_API_KEY=...
# Bedrock API key (ABSK… / MantleApiKey). Also accepts AWS_BEARER_TOKEN_BEDROCK.
TRACKER_AMAZON_API_KEY=...
# BEDROCK_REGION=us-east-1
# ANTHROPIC_API_KEY=...
# OPENAI_API_KEY=...
# GEMINI_API_KEY=...
# GOOGLE_API_KEY=...
# XAI_API_KEY=...
# DEEPSEEK_API_KEY=...
# QWEN_API_KEY=...
# AWS_BEARER_TOKEN_BEDROCK=...

